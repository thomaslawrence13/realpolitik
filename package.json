{
  "name": "realpolitik",
  "version": "0.1.0",
  "description": "Interactive geopolitical statistics dashboard prototype",
  "scripts": {
    "test": "npm run test:unit && npm run build",
    "test:unit": "tsx --test src/**/*.test.ts src/data/pipeline/*.test.ts src/data/quality/*.test.ts worker/index.test.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "ingest": "tsx scripts/ingest.ts",
    "history:build": "tsx scripts/buildHistoricalSeries.ts",
    "refresh:unvotes": "tsx scripts/unVotesRefresh.ts",
    "refresh:ofac": "tsx scripts/ofacRefresh.ts",
    "refresh:ucdp": "tsx scripts/ucdpRefresh.ts",
    "refresh:political": "npm run refresh:unvotes && npm run refresh:ofac && npm run refresh:ucdp",
    "validate:dataset": "tsx scripts/validateDataset.ts && tsx scripts/qualityReport.ts",
    "freshness:check": "tsx scripts/checkFreshness.ts",
    "artifacts:status": "tsx scripts/artifactStatus.ts",
    "quality:report": "tsx scripts/qualityReport.ts",
    "worker:types": "wrangler types worker-configuration.d.ts --include-runtime false",
    "worker:types:check": "wrangler types worker-configuration.d.ts --include-runtime false --check",
    "worker:check": "tsc -p worker/tsconfig.json --noEmit",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomaslawrence13/realpolitik.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/thomaslawrence13/realpolitik/issues"
  },
  "homepage": "https://github.com/thomaslawrence13/realpolitik#readme",
  "private": true,
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
